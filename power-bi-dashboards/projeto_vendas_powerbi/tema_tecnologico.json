{
  "name": "Tecnologico Escuro",
  "dataColors": ["#00D4FF", "#1E6BFF", "#8B5CF6", "#22D3A5", "#F59E0B", "#F43F5E", "#94A3B8", "#38BDF8"],
  "background": "#0B1220",
  "foreground": "#FFFFFF",
  "tableAccent": "#00D4FF",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#CBD5E1" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111A2E" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#24324F" } }, "radius": 12 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 14 }]
      }
    },
    "card": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#00D4FF" } }, "radius": 12 }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#24324F" } } }],
        "columnHeaders": [{ "backColor": { "solid": { "color": "#1E6BFF" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12 }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#111A2E" } }, "backColorSecondary": { "solid": { "color": "#16213A" } }, "fontColorPrimary": { "solid": { "color": "#FFFFFF" } }, "fontColorSecondary": { "solid": { "color": "#FFFFFF" } }, "fontSize": 11 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#24324F" } } }],
        "columnHeaders": [{ "backColor": { "solid": { "color": "#1E6BFF" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12 }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#111A2E" } }, "backColorSecondary": { "solid": { "color": "#16213A" } }, "fontColorPrimary": { "solid": { "color": "#FFFFFF" } }, "fontColorSecondary": { "solid": { "color": "#FFFFFF" } }, "fontSize": 11 }]
      }
    }
  }
}